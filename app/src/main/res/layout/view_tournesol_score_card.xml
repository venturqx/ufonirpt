<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/tournesol_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tournesol_section"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/logo_small" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/tournesol_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/tournesol_content_muted"
            android:textSize="@dimen/video_item_detail_description_text_size"
            tools:text="@string/tournesol_detail_load_error" />

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/tournesol_status_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/retry"
            android:textAllCaps="true"
            android:textColor="@color/tournesol_section_header"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Tournesol info section (shown when data is available) -->
    <LinearLayout
        android:id="@+id/tournesol_info_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tournesol_section"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/tournesol_section_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/tournesol_detail_scores_header"
            android:textAllCaps="true"
            android:textColor="@color/tournesol_section_header"
            android:letterSpacing="0.08"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/tournesol_score_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tournesol_logo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_small" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/tournesol_unsafe_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱"
                android:textSize="20sp"
                android:visibility="gone" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:id="@+id/tournesol_score_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:textColor="@color/tournesol_score"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="56.7" />

            <LinearLayout
                android:id="@+id/tournesol_distribution_container"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="end"
                android:orientation="vertical">

                <org.schabi.newpipe.views.NewPipeTextView
                    android:id="@+id/tournesol_contributors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tournesol_content_muted"
                    android:textSize="@dimen/video_item_detail_description_text_size"
                    tools:text="30 contributors" />

                <org.schabi.newpipe.views.NewPipeTextView
                    android:id="@+id/tournesol_comparisons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/tournesol_content_muted"
                    android:textSize="@dimen/video_item_detail_description_text_size"
                    tools:text="113 comparisons" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tournesol_score_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/logo_small" />

            <TextView
                android:id="@+id/tournesol_skeleton_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ems="2"
                android:includeFontPadding="false"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tournesol_skeleton_contributors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ems="6"
                    android:textSize="@dimen/video_item_detail_description_text_size" />

                <TextView
                    android:id="@+id/tournesol_skeleton_comparisons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ems="5"
                    android:textSize="@dimen/video_item_detail_description_text_size" />

            </LinearLayout>

        </LinearLayout>

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/tournesol_unsafe_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="@dimen/video_item_detail_description_text_size"
            android:visibility="gone"
            tools:text="⚠ Flagged as unsafe" />

    </LinearLayout>

    <!-- Tournesol criteria section (lollipop chart) -->
    <LinearLayout
        android:id="@+id/tournesol_criteria_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tournesol_section"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/tournesol_criteria_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/tournesol_detail_criteria_header"
            android:textAllCaps="true"
            android:textColor="@color/tournesol_section_header"
            android:letterSpacing="0.08"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/tournesol_criteria_skeleton"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/tournesol_lollipop_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</merge>
